<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Update this connection string according to your SQL Server setup -->
    <add name="KMindsDB" connectionString="Server=(localdb)\MSSQLLocalDB;Database=KMindsPortal;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    
    <!-- Forms Authentication Configuration -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="2880" defaultUrl="~/Default.aspx" />
    </authentication>

    <authorization>
      <!-- Allow all users to access the default pages by default -->
      <allow users="*" />
    </authorization>
  </system.web>

  <!-- Restrict access to Dashboard to logged-in users only -->
  <location path="Dashboard.aspx">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <!-- Restrict access to Profile to logged-in users only -->
  <location path="Profile.aspx">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <!-- Restrict access to ManageRoles to Presidents/Admins only -->
  <location path="ManageRoles.aspx">
    <system.web>
      <authorization>
        <allow roles="president,Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

</configuration>
